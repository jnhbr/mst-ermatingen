rules_version = '2';
// Firestore-Regeln für das Firebase-Projekt "minispieltag".
// Gelten für BEIDE Seiten: die Spieltag-Live-Seite (minispieltag.web.app)
// und die MST-Vereinsseite (jnhbr.github.io/mst-ermatingen).
// Quelle der Wahrheit ist diese Datei – deployen mit:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Vorstand = Login mit E-Mail/Passwort (Konten legt Jan in Firebase Authentication an).
    // roles/<e-mail> = { role:"admin"|"kassier"|"aktuar", memberId }. Ohne Eintrag = Admin
    // (Jans Konto) – nur Jan kann Passwort-Konten anlegen.
    function isVorstand() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function rolePath() {
      return /databases/$(database)/documents/roles/$(request.auth.token.email);
    }
    function role() {
      return exists(rolePath()) ? get(rolePath()).data.role : 'admin';
    }
    function isAdmin()   { return isVorstand() && role() == 'admin'; }
    function isKassier() { return isVorstand() && role() in ['admin', 'kassier']; }
    function isAktuar()  { return isVorstand() && role() in ['admin', 'aktuar']; }
    function vorstandId() {
      return exists(rolePath()) ? get(rolePath()).data.memberId : 'm10';
    }
    // Mitglied = anonymer Login + gültige Sitzung (Vereinsnummer + Vorname geprüft).
    function sessionPath() {
      return /databases/$(database)/documents/sessions/$(request.auth.uid);
    }
    function hasSession() {
      return request.auth != null && exists(sessionPath());
    }
    function me() {
      return get(sessionPath()).data.memberId;
    }
    function isMember() {
      return isVorstand() || hasSession();
    }
    // Mitgliedsnummer der eingeloggten Person (Vorstand über roles, sonst über die Sitzung)
    function myId() {
      return isVorstand() ? vorstandId() : me();
    }

    // ---------- Spieltag (minispieltag.web.app) ----------
    match /draws/{doc=**}     { allow read: if true; allow write: if isAdmin(); }
    match /persons/{doc=**}   { allow read: if true; allow write: if isAdmin(); }
    match /results/{doc=**}   { allow read: if true; allow write: if isAdmin(); }
    match /schedules/{doc=**} { allow read: if true; allow write: if isAdmin(); }

    // ---------- MST-Vereinsseite: Login ----------
    // Dokument-ID = SHA-256 von "mst-ermatingen|<Nummer>|<vorname>".
    // Lesbar nur, wer die ID kennt (kein Auflisten).
    match /members/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
    // Namen für Auswahllisten – nur für Eingeloggte.
    match /memberDirectory/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /sessions/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      // Admin entfernt Sitzungen ausgetretener Mitglieder
      allow list, delete: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key', 'memberId', 'at'])
        && request.resource.data.key is string
        && request.resource.data.key.matches('^[0-9a-f]{64}$')
        && get(/databases/$(database)/documents/members/$(request.resource.data.key)).data.id
           == request.resource.data.memberId;
    }

    // ---------- Spieltag auf der Vereinsseite (/spieltag/) ----------
    // Öffentlich lesbar (Zuschauer am Spieltag verfolgen live), schreiben nur Admin.
    // spieltagMeta/{settings|catalog}, spieltagPersons/<id> (nur Spielname + Mitglied-Nr.),
    // spieltag/<jahr> (+ games/<id>), spieltagHistory/<jahr>
    match /spieltagMeta/{doc}     { allow read: if true; allow write: if isAdmin(); }
    function personOfMe(pid) {
      return get(/databases/$(database)/documents/spieltagPersons/$(pid)).data.memberId == myId();
    }
    match /spieltagPersons/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // Mitglied ohne Spielname darf sich selbst anlegen (für die Selbst-Anmeldung)
      allow create: if isMember() && id == myId()
        && request.resource.data.keys().hasOnly(['name', 'memberId'])
        && request.resource.data.memberId == myId() && request.resource.data.name is string;
    }
    match /spieltag/{year}        { allow read: if true; allow write: if isAdmin(); }
    // Spiel: Admin alles; Stationsleiter (games/<id>.leaders) Resultate + Material abhaken;
    // während «Resultate für alle offen» (spieltag/<jahr>.entryOpen) alle eingeloggten Mitglieder
    // Resultate und Teamnamen. Jede Änderung landet im Protokoll (log).
    match /spieltag/{year}/games/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isMember() && myId() in resource.data.get('leaders', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matches', 'scores', 'teamNames', 'materialDone']);
      allow update: if isMember()
        && get(/databases/$(database)/documents/spieltag/$(year)).data.get('entryOpen', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matches', 'scores', 'teamNames']);
    }
    // Selbst-Anmeldung: signups/<memberId> = { pid, status:"ja"|"nein", at }, nur solange offen
    // (signupOpen bzw. Anmeldeschluss gesetzt) und bis zum Anmeldeschluss spieltag/<jahr>.signupUntil = "JJJJ-MM-TT" (der Tag zählt noch,
    // Schluss um Mitternacht Schweizer Sommerzeit = 22:00 UTC).
    function signupDeadline(iso) {
      let p = iso.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(22, 'h');
    }
    function signupIsOpen(year) {
      let y = get(/databases/$(database)/documents/spieltag/$(year)).data;
      let until = y.get('signupUntil', null);
      // Schalter signupOpen; nie gesetzt = offen, sobald ein Anmeldeschluss gespeichert ist
      return y.get('signupOpen', until != null) == true
        && (until == null || request.time < signupDeadline(until));
    }
    match /spieltag/{year}/signups/{mid} {
      allow read: if true;
      allow write: if isAdmin();
      allow create, update: if isMember() && mid == myId()
        && signupIsOpen(year)
        && request.resource.data.keys().hasOnly(['pid', 'status', 'at'])
        && request.resource.data.status in ['ja', 'nein']
        && personOfMe(request.resource.data.pid);
    }
    // Bierkapitän: nur für Eingeloggte sichtbar; jedes Mitglied zählt nur für sich selbst
    match /spieltag/{year}/beer/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
      allow create: if isMember() && request.resource.data.by == myId()
        && request.resource.data.keys().hasOnly(['pid', 'l', 'at', 'by'])
        && request.resource.data.l in [0.5, 0.33]
        && personOfMe(request.resource.data.pid);
      allow delete: if isMember() && resource.data.by == myId();
    }
    match /spieltagHistory/{year} { allow read: if true; allow write: if isAdmin(); }

    // ---------- Konfiguration, Rollen & Änderungsprotokoll ----------
    match /config/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /roles/{email} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Jede Änderung schreibt einen Eintrag; lesen kann nur der Admin.
    match /log/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if (isVorstand() && request.resource.data.by == vorstandId())
        || (isMember() && request.resource.data.by == myId());
    }

    // ---------- Padel ----------
    // padel/<saison> = Konfiguration der Saison (Termine, Preise, Fixe, Ausfälle)
    match /padel/{season} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Ein Dokument pro Donnerstag: Feld <memberId> = Verfügbarkeit,
    // "extras" = Gäste/Mitglieder, "cancelled" = Absage (nur Admin).
    match /padel/{season}/days/{date} {
      allow read: if isMember();
      allow write: if isAdmin();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly([myId(), 'extras']);
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([myId(), 'extras']);
    }
    match /padel/{season}/beer/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
      allow create: if isMember() && request.resource.data.by == myId();
      allow update: if isMember() && resource.data.by == myId() && request.resource.data.by == myId();
      allow delete: if isMember() && resource.data.by == myId();
    }

    // ---------- Afterworkbar ----------
    // Öffentliche Karte (QR-Code an der Bar): für alle lesbar.
    match /awbMenu/{year} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // awb/<jahr> = Datum, Mitgliederpreise usw.
    match /awb/{year} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Einsatzplan: Mitglieder tragen sich in einen freien Slot ein oder wieder aus.
    match /awb/{year}/shifts/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignee', 'assigneeName', 'at'])
        && ((resource.data.assignee == null && request.resource.data.assignee == myId())
            || (resource.data.assignee == myId() && request.resource.data.assignee == null));
    }
    // Checkliste und Material: Mitglieder dürfen nur abhaken (mit eigenem Namen).
    match /awb/{year}/{list}/{id} {
      allow read: if isMember() && list in ['tasks', 'material'];
      allow write: if isAdmin() && list in ['tasks', 'material'];
      allow update: if isMember() && list in ['tasks', 'material']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy', 'doneByName', 'doneAt'])
        && (request.resource.data.done == false || request.resource.data.doneBy == myId());
    }

    // ---------- GV ----------
    // gv/<jahr> = GV (Traktanden, Beschlüsse, Eckdaten), chunks/<n> = PDF (Base64-Stücke),
    // protokoll/main = Protokoll (Aktuar), antraege/<id> = Traktanden-Vorschläge der Mitglieder.
    // Enthält Finanzen -> nur für eingeloggte Mitglieder.
    match /gv/{year} {
      allow read: if isMember();
      allow write: if isVorstand();
    }
    match /gv/{year}/chunks/{n} {
      allow read: if isMember();
      allow write: if isVorstand();
    }
    match /gv/{year}/protokoll/{doc} {
      allow read: if isMember();
      allow write: if isAktuar();
    }
    match /gv/{year}/antraege/{id} {
      allow read: if isMember();
      allow write: if isVorstand();
      allow create: if isMember() && request.resource.data.by == myId()
        && request.resource.data.keys().hasOnly(['title', 'text', 'by', 'byName', 'at', 'status'])
        && request.resource.data.status == 'neu';
      allow delete: if isMember() && resource.data.by == myId() && resource.data.status == 'neu';
    }

    // ---------- Kontakte (Handynummern für Twint-Anforderungen) – nur Vorstand ----------
    match /contacts/{id} {
      allow read, write: if isVorstand();
    }

    // ---------- Finanzen (Kassier) ----------
    // finance/<gv-jahr>/belege/<buchung>_<n> = Beleg (Foto/PDF als Base64-Stücke)
    // finance/<gv-jahr> = Vereinsjahr (Anfangsbestand, Kasse, Beitrag),
    // finance/<gv-jahr>/bookings/<id> = Kontobewegungen, finance/<gv-jahr>/fees/<memberId> = Jahresbeiträge
    // Während des Vereinsjahrs liest nur der Vorstand; an der GV gibt der Kassier das Jahr frei
    // (finance/<jahr>.shared = true), dann sehen es alle eingeloggten Mitglieder.
    function financeShared(year) {
      return get(/databases/$(database)/documents/finance/$(year)).data.get('shared', false) == true;
    }
    match /finance/{year} {
      allow read: if isVorstand() || (isMember() && resource.data.get('shared', false) == true);
      allow write: if isKassier();
    }
    match /finance/{year}/{list}/{id} {
      allow read: if isVorstand() || (isMember() && financeShared(year));
      allow write: if isKassier();
    }
  }
}
